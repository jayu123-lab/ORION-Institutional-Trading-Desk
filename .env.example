# ============================================================================
# ORION INSTITUTIONAL TRADING DESK — environment template
# Copia este archivo a .env y rellena SOLO lo que uses.
# NUNCA hagas commit de .env. Nunca pegues secretos en chats, issues o logs.
# ============================================================================

# --- Core ---
ORION_ENV=development                 # development | production
ORION_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
DATABASE_URL=sqlite:///./data/orion.db   # Postgres: postgresql+psycopg://user:pass@host:5432/orion
REDIS_URL=redis://localhost:6379/0    # Phase 2 (opcional)
DATA_DIR=./data

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Seguridad / ejecución ---
# LIVE está DESACTIVADO salvo que ambos valores estén configurados correctamente.
ORION_LIVE_MODE=false
ORION_LIVE_CONFIRM_TOKEN=
# Secreto compartido para el receptor de webhooks de TradingView (cabecera X-ORION-Secret)
TRADINGVIEW_WEBHOOK_SECRET=

# --- Monitor ---
MONITOR_HEARTBEAT_SECONDS=30
MONITOR_QUOTE_STALENESS_SEC=120       # umbral STALE por defecto

# Feed LIVE de crypto vía Polymarket RTDS embebido en la API (single-node).
# Publica PRICE_UPDATE por /ws/events y escribe quotes LIVE en BD.
POLYMARKET_WS_EMBEDDED=true

# --- Proveedores (rellena solo si dispones de cuenta) ---
# Polymarket: lectura pública NO requiere clave (Gamma). CLOB trading sí (Phase 5).
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# POLYMARKET_API_KEY=            # solo trading CLOB — no necesario en Fase 1-4
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# Brokers oficiales (Phase 5) — verificar documentación vigente antes de activar
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ACCESS_TOKEN=
# IBKR_GATEWAY_URL=

# Market data REST (opcionales)
# TWELVEDATA_API_KEY=
# FINNHUB_API_KEY=
# POLYGON_API_KEY=

# LLM provider para OpenCode se configura fuera del repo (~/.config/opencode),
# nunca aquí.
